<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>Your TextBee cart is still open</title>
    <style>
      .preheader { display:none !important; visibility:hidden; opacity:0; color:transparent; height:0; width:0; overflow:hidden; mso-hide:all; }
      @media screen and (max-width: 600px) {
        .container { width:100% !important; }
        .p-sm { padding:16px !important; }
      }
    </style>
  </head>
  <body style='margin:0; padding:0; background:#f7f9fc;'>
    <div class='preheader'>If you got interrupted, no worries — your cart is still saved and ready when you are.</div>

    <table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='background:#f7f9fc;'>
      <tr>
        <td align='center' style='padding:24px;'>
          <table role='presentation' cellpadding='0' cellspacing='0' border='0' width='600' class='container' style='width:600px; max-width:600px;'>

            <!-- Header -->
            <tr>
              <td style='padding:12px 16px 0 16px;'>
                <table role='presentation' cellspacing='0' cellpadding='0' border='0'>
                  <tr>
                    <td valign='middle' style='padding-right:10px;'>
                      <img src='https://textbee.dev/images/logo.png' alt='TextBee' width='36' height='36' style='display:block; border:0; outline:none; text-decoration:none;' />
                    </td>
                    <td valign='middle' style='font:600 18px Arial, Helvetica, sans-serif; color:#EA580C;'>textbee.dev</td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Main Card -->
            <tr>
              <td align='center' style='padding:16px 16px 0 16px;'>
                <table role='presentation' width='100%' cellspacing='0' cellpadding='0' border='0' style='background:#ffffff; border-radius:10px;'>

                  <!-- Hero -->
                  <tr>
                    <td align='center' style='background:#F97316; border-radius:10px 10px 0 0; padding:28px 20px;'>
                      <div style='font:700 24px Arial, Helvetica, sans-serif; color:#ffffff;'>Your cart is still open</div>
                      <div style='font:400 14px Arial, Helvetica, sans-serif; color:#fff; opacity:0.95; padding-top:6px;'>Pick up right where you left off</div>
                    </td>
                  </tr>

                  <!-- Body -->
                  <tr>
                    <td class='p-sm' style='padding:28px; font:16px/1.6 Arial, Helvetica, sans-serif; color:#111827;'>

                      <div style='font:700 18px Arial, Helvetica, sans-serif; color:#111827; margin-bottom:8px;'>Hi {{name}},</div>

                      <p style='margin:0 0 16px 0;'>You were a few clicks away from upgrading to TextBee Pro. If something came up or there was a hiccup with the page, no worries — your checkout session is still saved and ready to go.</p>

                      <!-- Trust box -->
                      <table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='margin:18px 0;'>
                        <tr>
                          <td style='padding:16px; background:#f0f9ff; border-left:4px solid #0ea5e9; border-radius:6px;'>
                            <div style='font:600 15px Arial, Helvetica, sans-serif; color:#0c4a6e; margin-bottom:4px;'>$10/month — cancel anytime, no commitment</div>
                            <div style='font:14px/1.5 Arial, Helvetica, sans-serif; color:#075985;'>Your plan is billed monthly. Cancel from your dashboard whenever you like — no questions asked.</div>
                          </td>
                        </tr>
                      </table>

                      <!-- CTA -->
                      <div style='text-align:center; padding:8px 0 24px;'>
                        <a href='{{checkoutUrl}}' style='background:#F97316; border:1px solid #EA580C; border-radius:6px; color:#ffffff; display:inline-block; font:700 16px Arial, Helvetica, sans-serif; line-height:48px; text-align:center; text-decoration:none; width:280px;'>Complete my upgrade</a>
                      </div>

                      <!-- Features -->
                      <div style='font:700 15px Arial, Helvetica, sans-serif; color:#111827; margin:0 0 12px;'>What changes when you upgrade:</div>
                      <ul style='padding-left:18px; margin:0 0 20px; font:14px/1.8 Arial, Helvetica, sans-serif; color:#374151;'>
                        <li style='margin:2px 0;'>5,000 messages/month <span style='color:#9ca3af;'>(up from 300)</span></li>
                        <li style='margin:2px 0;'>5 registered devices <span style='color:#9ca3af;'>(up from 1)</span></li>
                        <li style='margin:2px 0;'>No daily message limit <span style='color:#9ca3af;'>(was 50/day)</span></li>
                        <li style='margin:2px 0;'>500 req/s API rate <span style='color:#9ca3af;'>(up from 60)</span></li>
                        <li style='margin:2px 0;'>Unlimited bulk SMS recipients</li>
                        <li style='margin:2px 0;'>Priority support</li>
                      </ul>

                      <!-- Secondary link -->
                      <div style='text-align:center; margin:4px 0 20px;'>
                        <a href='https://textbee.dev/pricing' style='font:600 14px Arial, Helvetica, sans-serif; color:#EA580C; text-decoration:underline;'>View full pricing details →</a>
                      </div>

                      <!-- Support -->
                      <table role='presentation' cellpadding='0' cellspacing='0' border='0' width='100%' style='margin:4px 0; padding:16px; background:#f8f9fa; border-radius:8px;'>
                        <tr>
                          <td style='font:14px/1.5 Arial, Helvetica, sans-serif; color:#6b7280; text-align:center;'>
                            Questions? Reply to this email or reach us at <a href='mailto:support@textbee.dev' style='color:#EA580C; text-decoration:underline;'>support@textbee.dev</a>
                          </td>
                        </tr>
                      </table>

                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align='center' style='padding:16px; font:12px/1.6 Arial, Helvetica, sans-serif; color:#6b7280;'>
                <div>© 2026 textbee.dev. All rights reserved.</div>
                <div style='margin-top:4px;'>
                  <a href='https://app.textbee.dev/dashboard/account/' style='color:#6b7280; text-decoration:underline;'>Manage notifications</a>
                </div>
                <div style='margin-top:8px; color:#9ca3af;'>You're receiving this because you started a TextBee Pro checkout. To stop these reminders, manage your notifications above.</div>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
